{
  "schema_version": 1,
  "id": "grok",
  "sort_order": 70,
  "name": "Grok Build",
  "remark": "网关会添加两个自定义服务商，分别预置了 gpt-latest 和 claude-latest 模型。\n需要配置模型映射将其映射到实际上游模型，启动 Grok 即走网关，无需登录。",
  "icon": {
    "view_box": "0 0 34 32",
    "paths": [
      {
        "d": "M13.374 20.5407L24.4555 12.3506C24.9988 11.9491 25.7753 12.1057 26.0342 12.7294C27.3966 16.0185 26.7879 19.9712 24.0772 22.6851C21.3666 25.3989 17.595 25.9941 14.1477 24.6386L10.3818 26.3843C15.7832 30.0806 22.3422 29.1665 26.4409 25.0601C29.692 21.8051 30.6989 17.3683 29.7574 13.3673L29.7659 13.3758C28.4006 7.49809 30.1016 5.14871 33.5859 0.344576C33.6683 0.230667 33.7508 0.116757 33.8333 0L29.2482 4.59055V4.57631L13.3712 20.5436",
        "fill": "#52525b"
      },
      {
        "d": "M11.0867 22.5312C7.20979 18.8234 7.87821 13.0852 11.1862 9.77618C13.6323 7.3271 17.64 6.32755 21.1385 7.79698L24.8959 6.05986C24.219 5.57005 23.3514 5.04322 22.3559 4.67301C17.8562 2.81914 12.469 3.7418 8.81115 7.40114C5.29271 10.9238 4.18626 16.3402 6.08628 20.9621C7.5056 24.4164 5.17893 26.8597 2.8352 29.3259C2.00465 30.2001 1.17126 31.0744 0.5 31.9999L11.0838 22.534",
        "fill": "#52525b"
      }
    ]
  },
  "config_dir": "~/.grok",
  "user_agent": ["grok-shell"],
  "protocols": ["openai_responses", "anthropic_messages"],
  "features": {
    "provider_config": {
      "enabled": true,
      "operations": [
        {
          "id": "set-openai-model",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-openai", "model"],
          "value": "gpt-latest"
        },
        {
          "id": "set-openai-name",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-openai", "name"],
          "value": "CCG-Gateway (OpenAI)"
        },
        {
          "id": "set-openai-base-url",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-openai", "base_url"],
          "value": "{target.endpoint}/v1"
        },
        {
          "id": "set-openai-api-backend",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-openai", "api_backend"],
          "value": "responses"
        },
        {
          "id": "set-openai-api-key",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-openai", "api_key"],
          "value": "{target.token}"
        },
        {
          "id": "set-openai-context-window",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-openai", "context_window"],
          "value": 1000000
        },
        {
          "id": "set-anthropic-model",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-anthropic", "model"],
          "value": "claude-latest"
        },
        {
          "id": "set-anthropic-name",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-anthropic", "name"],
          "value": "CCG-Gateway (Anthropic)"
        },
        {
          "id": "set-anthropic-base-url",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-anthropic", "base_url"],
          "value": "{target.endpoint}/v1"
        },
        {
          "id": "set-anthropic-api-backend",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-anthropic", "api_backend"],
          "value": "messages"
        },
        {
          "id": "set-anthropic-api-key",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-anthropic", "api_key"],
          "value": "{target.token}"
        },
        {
          "id": "set-anthropic-context-window",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["model", "ccg-anthropic", "context_window"],
          "value": 1000000
        },
        {
          "id": "set-default-model",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["models", "default"],
          "value": "ccg-openai"
        }
      ]
    },
    "global_preset": {
      "enabled": true,
      "file": "config.toml",
      "format": "toml"
    },
    "profiles": { "enabled": false },
    "official_login": {
      "enabled": true,
      "operations": [
        {
          "id": "replace-grok-auth",
          "op": "replace_file",
          "file": "auth.json",
          "content_from": { "file_id": "grok_auth" }
        }
      ]
    },
    "model_mapping": { "enabled": true },
    "token_usage": { "enabled": true },
    "skills": { "enabled": true, "directory": "skills" },
    "mcp": {
      "enabled": true,
      "file": "config.toml",
      "format": "toml",
      "servers_path": ["mcp_servers"]
    },
    "sessions": { "enabled": true, "adapter": "grok" },
    "plugins": { "enabled": false },
    "prompts": { "enabled": true, "file": "AGENTS.md" }
  }
}
