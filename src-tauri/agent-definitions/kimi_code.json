{
  "schema_version": 1,
  "id": "kimi_code",
  "sort_order": 50,
  "name": "Kimi Code",
  "remark": "网关会接管 KimiCode 内置的 anthropic 与 openai 服务商。\n注意：需要先在 KimiCode 中通过 /provider 命令添加 anthropic 和 openai 服务商（key随意输入）并选择模型，然后再开启网关中 KimiCode 的路由模式。",
  "icon": {
    "view_box": "0 0 54 38",
    "paths": [
      {
        "d": "M0 0H54V38H0Z",
        "fill": "#4FA8FF"
      },
      {
        "d": "M18 10H22V19H18Z M36 10H40V19H36Z",
        "fill": "#0C0C0C"
      }
    ]
  },
  "config_dir": "~/.kimi-code",
  "user_agent": ["kimi-code-cli"],
  "protocols": ["openai_chat", "anthropic_messages"],
  "features": {
    "provider_config": {
      "enabled": true,
      "operations": [
        {
          "id": "set-anthropic-endpoint",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["providers", "anthropic", "base_url"],
          "value": "{target.endpoint}"
        },
        {
          "id": "set-anthropic-token",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["providers", "anthropic", "api_key"],
          "value": "{target.token}"
        },
        {
          "id": "set-openai-endpoint",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["providers", "openai", "base_url"],
          "value": "{target.endpoint}"
        },
        {
          "id": "set-openai-token",
          "op": "set",
          "file": "config.toml",
          "format": "toml",
          "path": ["providers", "openai", "api_key"],
          "value": "{target.token}"
        }
      ]
    },
    "global_preset": {
      "enabled": true,
      "file": "config.toml",
      "format": "toml"
    },
    "profiles": { "enabled": false },
    "official_login": {
      "enabled": true,
      "operations": [
        {
          "id": "replace-kimi-oauth",
          "op": "replace_file",
          "file": "credentials/oauth/kimi-code.json",
          "content_from": { "file_id": "kimi_oauth" }
        }
      ]
    },
    "model_mapping": { "enabled": true },
    "token_usage": { "enabled": true },
    "skills": { "enabled": true, "directory": "skills" },
    "mcp": {
      "enabled": true,
      "file": "mcp.json",
      "format": "json",
      "servers_path": ["mcpServers"]
    },
    "sessions": { "enabled": true, "adapter": "kimi_code" },
    "plugins": { "enabled": false },
    "prompts": { "enabled": true, "file": "AGENTS.md" }
  }
}
