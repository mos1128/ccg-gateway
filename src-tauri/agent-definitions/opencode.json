{
  "schema_version": 1,
  "id": "opencode",
  "sort_order": 40,
  "name": "OpenCode",
  "remark": "网关会接管 OpenCode 内置的 anthropic 与 openai 服务商；选择 anthropic 与 openai 的模型即可。",
  "icon": {
    "view_box": "0 0 48 48",
    "color": "#808080",
    "paths": [
      {
        "d": "M0 0H48V48H0V0ZM12 9V39H36V9H12Z",
        "fill_rule": "evenodd"
      },
      {
        "d": "M18 15H30V33H18V15Z"
      }
    ]
  },
  "config_dir": "~/.config/opencode",
  "user_agent": ["opencode"],
  "protocols": ["openai_responses", "anthropic_messages"],
  "features": {
    "provider_config": {
      "enabled": true,
      "operations": [
        {
          "id": "set-schema",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["$schema"],
          "value": "https://opencode.ai/config.json"
        },
        {
          "id": "set-anthropic-endpoint",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["provider", "anthropic", "options", "baseURL"],
          "value": "{target.endpoint}/v1"
        },
        {
          "id": "set-anthropic-token",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["provider", "anthropic", "options", "apiKey"],
          "value": "{target.token}"
        },
        {
          "id": "set-openai-endpoint",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["provider", "openai", "options", "baseURL"],
          "value": "{target.endpoint}"
        },
        {
          "id": "set-openai-token",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["provider", "openai", "options", "apiKey"],
          "value": "{target.token}"
        }
      ]
    },
    "global_preset": {
      "enabled": true,
      "file": "opencode.json",
      "format": "json"
    },
    "profiles": { "enabled": false },
    "official_login": { "enabled": false },
    "model_mapping": { "enabled": true },
    "token_usage": { "enabled": true },
    "skills": { "enabled": true, "directory": "skills" },
    "mcp": {
      "enabled": true,
      "file": "opencode.json",
      "format": "json",
      "adapter": "opencode",
      "servers_path": ["mcp"]
    },
    "sessions": { "enabled": true, "adapter": "opencode" },
    "plugins": { "enabled": false },
    "prompts": { "enabled": true, "file": "AGENTS.md" }
  }
}
