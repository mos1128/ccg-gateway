{
  "schema_version": 1,
  "id": "opencode",
  "sort_order": 40,
  "name": "OpenCode",
  "remark": "网关会接管 anthropic、openai 服务商；分别使用 Anthropic Messages、OpenAI Responses 协议，选择对应的模型即可。\nOpenCode CLI 和桌面端共享配置。",
  "remark_en": "The gateway takes over the anthropic and openai providers, using the Anthropic Messages and OpenAI Responses protocols respectively — just pick the corresponding models.\nThe OpenCode CLI and desktop app share configuration.",
  "icon": {
    "view_box": "0 0 512 512",
    "paths": [
      {
        "d": "M0 0H512V512H0Z",
        "fill": "#131010"
      },
      {
        "d": "M320 224V352H192V224H320Z",
        "fill": "#5A5858"
      },
      {
        "d": "M384 416H128V96H384V416ZM320 160H192V352H320V160Z",
        "fill": "#FFFFFF",
        "fill_rule": "evenodd"
      }
    ]
  },
  "config_dir": "~/.config/opencode",
  "user_agent": ["opencode"],
  "protocols": ["openai_responses", "anthropic_messages"],
  "features": {
    "provider_config": {
      "enabled": true,
      "operations": [
        {
          "id": "set-schema",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["$schema"],
          "value": "https://opencode.ai/config.json"
        },
        {
          "id": "set-anthropic-endpoint",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["providers", "anthropic", "settings", "baseURL"],
          "value": "{target.endpoint}/v1"
        },
        {
          "id": "set-anthropic-token",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["providers", "anthropic", "settings", "apiKey"],
          "value": "{target.token}"
        },
        {
          "id": "set-openai-endpoint",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["providers", "openai", "settings", "baseURL"],
          "value": "{target.endpoint}"
        },
        {
          "id": "set-openai-token",
          "op": "set",
          "file": "opencode.json",
          "format": "json",
          "path": ["providers", "openai", "settings", "apiKey"],
          "value": "{target.token}"
        }
      ]
    },
    "global_preset": {
      "enabled": true,
      "file": "opencode.json",
      "format": "json"
    },
    "profiles": { "enabled": false },
    "official_login": { "enabled": false },
    "model_mapping": { "enabled": true },
    "token_usage": { "enabled": true },
    "skills": { "enabled": true, "directory": "skills" },
    "mcp": {
      "enabled": true,
      "file": "opencode.json",
      "format": "json",
      "adapter": "opencode",
      "servers_path": ["mcp", "servers"]
    },
    "sessions": { "enabled": true, "adapter": "opencode" },
    "plugins": { "enabled": false },
    "prompts": { "enabled": true, "file": "AGENTS.md" }
  }
}
