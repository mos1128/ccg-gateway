{
  "schema_version": 1,
  "id": "zcode",
  "sort_order": 60,
  "name": "ZCode",
  "remark": "网关会添加两个自定义服务商，分别预置了 gpt-latest 和 claude-latest 模型。\n需要配置模型映射将其映射到实际上游模型，启动 ZCode 即走网关，无需登录。",
  "icon": {
    "view_box": "-80 -99 416 416",
    "color": "#5b6cff",
    "paths": [
      {
        "d": "M0 -99H256A80 80 0 0 1 336 -19V237A80 80 0 0 1 256 317H0A80 80 0 0 1 -80 237V-19A80 80 0 0 1 0 -99Z",
        "fill": "#090A0C"
      },
      {
        "d": "M134.4 0.130152L116.48 25.6022C113.665 29.5699 109.054 32.0019 104.064 32.0019H6.3999V0C6.3999 0.130149 134.4 0.130152 134.4 0.130152Z",
        "fill": "#FFFFFF"
      },
      {
        "d": "M256 0.130127L102.401 217.732H0L153.599 0.130127H256Z",
        "fill": "#FFFFFF"
      },
      {
        "d": "M121.601 217.732L139.65 192.134C142.465 188.166 147.076 185.734 152.067 185.734H249.604V217.736H121.601V217.732Z",
        "fill": "#FFFFFF"
      }
    ]
  },
  "config_dir": "~/.zcode",
  "user_agent": ["zcode"],
  "protocols": ["openai_responses", "anthropic_messages"],
  "features": {
    "provider_config": {
      "enabled": true,
      "operations": [
        {
          "id": "set-openai-name",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "name"],
          "value": "CCG-Gateway (OpenAI)"
        },
        {
          "id": "set-openai-kind",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "kind"],
          "value": "openai"
        },
        {
          "id": "set-openai-source",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "source"],
          "value": "custom"
        },
        {
          "id": "set-openai-endpoint",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "options", "baseURL"],
          "value": "{target.endpoint}"
        },
        {
          "id": "set-openai-token",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "options", "apiKey"],
          "value": "{target.token}"
        },
        {
          "id": "set-openai-key-required",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "options", "apiKeyRequired"],
          "value": true
        },
        {
          "id": "set-openai-model-context",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-openai", "models", "gpt-latest", "limit", "context"],
          "value": 1000000
        },
        {
          "id": "set-anthropic-name",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "name"],
          "value": "CCG-Gateway (Anthropic)"
        },
        {
          "id": "set-anthropic-kind",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "kind"],
          "value": "anthropic"
        },
        {
          "id": "set-anthropic-source",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "source"],
          "value": "custom"
        },
        {
          "id": "set-anthropic-endpoint",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "options", "baseURL"],
          "value": "{target.endpoint}"
        },
        {
          "id": "set-anthropic-token",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "options", "apiKey"],
          "value": "{target.token}"
        },
        {
          "id": "set-anthropic-key-required",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "options", "apiKeyRequired"],
          "value": true
        },
        {
          "id": "set-anthropic-model-context",
          "op": "set",
          "file": "v2/config.json",
          "format": "json",
          "path": ["provider", "ccg-anthropic", "models", "claude-latest", "limit", "context"],
          "value": 1000000
        }
      ]
    },
    "global_preset": {
      "enabled": true,
      "file": "v2/config.json",
      "format": "json"
    },
    "profiles": { "enabled": false },
    "official_login": { "enabled": false },
    "model_mapping": { "enabled": true },
    "token_usage": { "enabled": true },
    "skills": { "enabled": true, "directory": "skills" },
    "mcp": {
      "enabled": true,
      "file": "cli/config.json",
      "format": "json",
      "servers_path": ["mcp", "servers"]
    },
    "sessions": { "enabled": true, "adapter": "zcode" },
    "plugins": { "enabled": false },
    "prompts": { "enabled": true, "file": "AGENTS.md" }
  }
}
